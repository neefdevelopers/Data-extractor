# Local Database Connection (PostgreSQL or SQLite fallback for instant zero-config start)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pinlytics
# Fallback if PostgreSQL is not yet started: sqlite:///./pinlytics.db

# India Postal API Configuration
POSTAL_API_URL=https://api.postalpincode.in/pincode/

# File storage directories (relative to project root or absolute)
UPLOAD_DIR=../uploads
EXPORT_DIR=../exports

# App settings
DEBUG=True
APP_NAME=Pinlytics
